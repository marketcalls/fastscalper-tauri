{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FastScalper",
  "version": "../package.json",
  "identifier": "com.fastscalper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FastScalper",
        "width": 320,
        "height": 125,
        "minWidth": 300,
        "minHeight": 115,
        "resizable": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Compact order pad for OpenAlgo",
    "longDescription": "FastScalper is a small always-ready window for placing long and short entry and exit market orders through a self-hosted OpenAlgo server.",
    "copyright": "Copyright (c) marketcalls. MIT License.",
    "homepage": "https://github.com/marketcalls/fastscalper-tauri",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "upgradeCode": "fe79e516-2efa-53a9-a951-f69e8c9b877d"
      }
    },
    "linux": {
      "deb": {
        "conflicts": ["fastscalper"],
        "replaces": ["fastscalper"]
      },
      "rpm": {
        "obsoletes": ["fastscalper"]
      }
    }
  }
}
